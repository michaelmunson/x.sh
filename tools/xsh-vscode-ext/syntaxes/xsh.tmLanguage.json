{
  "name": "x.sh app",
  "scopeName": "source.xsh",
  "fileTypes": [
    "x.yml",
    "cli.yaml",
    "cli.yml"
  ],
  "patterns": [
    { "include": "#comment" },
    { "include": "#root-dollar-block" },
    { "include": "#root-dollar-inline" },
    { "include": "#opts-block-scalar" },
    { "include": "#opts-section" },
    { "include": "#args-block-scalar" },
    { "include": "#args-section" },
    { "include": "#args-inline" },
    { "include": "#dir-key" },
    { "include": "#alias-key" },
    { "include": "#help-key" },
    { "include": "#dot-command-shorthand-block" },
    { "include": "#dot-command-shorthand-inline" },
    { "include": "#dot-command-key" },
    { "include": "source.yaml" },
    { "include": "#yaml-fallback" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.xsh"
    },

    "dot-command-key": {
      "begin": "^(\\s*)(\\.)([a-zA-Z][a-zA-Z0-9_-]*)(:)\\s*$",
      "beginCaptures": {
        "2": { "name": "entity.name.type.class.xsh" },
        "3": { "name": "entity.name.type.class.xsh" },
        "4": { "name": "punctuation.separator.key-value.mapping.yaml" }
      },
      "end": "^(?!\\1\\s)",
      "patterns": [
        { "include": "#comment" },
        { "include": "#root-dollar-block" },
        { "include": "#root-dollar-inline" },
        { "include": "#opts-block-scalar" },
        { "include": "#opts-section" },
        { "include": "#args-block-scalar" },
        { "include": "#args-section" },
        { "include": "#args-inline" },
        { "include": "#dir-key" },
        { "include": "#alias-key" },
        { "include": "#help-key" },
        { "include": "#dot-command-shorthand-block" },
        { "include": "#dot-command-shorthand-inline" },
        { "include": "#dot-command-key" },
        { "include": "#yaml-fallback" }
      ]
    },

    "dot-command-shorthand-block": {
      "begin": "^(\\s*)(\\.)([a-zA-Z][a-zA-Z0-9_-]*)(:)\\s+(\\||>)[-+]?\\s*$",
      "beginCaptures": {
        "2": { "name": "entity.name.type.class.xsh" },
        "3": { "name": "entity.name.type.class.xsh" },
        "4": { "name": "punctuation.separator.key-value.mapping.yaml" },
        "5": { "name": "keyword.control.flow.block-scalar.literal.yaml" }
      },
      "end": "^(?!\\1\\s|\\s*$)",
      "contentName": "meta.embedded.block.shell",
      "patterns": [
        { "include": "#x-builtin-directive" },
        { "include": "#x-template-vars" },
        { "include": "source.shell" }
      ]
    },

    "dot-command-shorthand-inline": {
      "match": "^(\\s*)(\\.)([a-zA-Z][a-zA-Z0-9_-]*)(:)\\s+(\"[^\"]*\"|'[^']*'|[^\\s#].*)$",
      "captures": {
        "2": { "name": "entity.name.type.class.xsh" },
        "3": { "name": "entity.name.type.class.xsh" },
        "4": { "name": "punctuation.separator.key-value.mapping.yaml" },
        "5": {
          "contentName": "meta.embedded.line.shell",
          "patterns": [
            { "include": "#x-builtin-directive" },
            { "include": "#x-template-vars" },
            { "include": "source.shell" }
          ]
        }
      }
    },

    "root-dollar-block": {
      "begin": "^(\\s*)(\\$)(:)\\s+(\\||>)[-+]?\\s*$",
      "beginCaptures": {
        "2": { "name": "keyword.other.script.xsh" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" },
        "4": { "name": "keyword.control.flow.block-scalar.literal.yaml" }
      },
      "end": "^(?!\\1\\s|\\s*$)",
      "contentName": "meta.embedded.block.shell",
      "patterns": [
        { "include": "#x-builtin-directive" },
        { "include": "#x-template-vars" },
        { "include": "source.shell" }
      ]
    },

    "root-dollar-inline": {
      "match": "^(\\s*)(\\$)(:)\\s+(\"[^\"]*\"|'[^']*'|[^\\s#].*)$",
      "captures": {
        "2": { "name": "keyword.other.script.xsh" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" },
        "4": {
          "contentName": "meta.embedded.line.shell",
          "patterns": [
            { "include": "#x-builtin-directive" },
            { "include": "#x-template-vars" },
            { "include": "source.shell" }
          ]
        }
      }
    },

    "help-key": {
      "match": "^(\\s*)(help|description)(:)",
      "captures": {
        "2": { "name": "keyword.other.section.xsh" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" }
      }
    },

    "dir-key": {
      "match": "^(\\s*)(dir)(:)(\\s+)(.+)$",
      "captures": {
        "2": { "name": "keyword.other.section.xsh" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" },
        "5": { "name": "string.unquoted.path.xsh" }
      }
    },

    "alias-key": {
      "match": "^(\\s*)(alias)(:)(\\s+)(.+)$",
      "captures": {
        "2": { "name": "keyword.control.import.xsh" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" },
        "5": { "name": "string.unquoted.path.xsh" }
      }
    },

    "opts-section": {
      "begin": "^(\\s*)(options|opts)(:)\\s*$",
      "beginCaptures": {
        "2": { "name": "keyword.other.section.xsh" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" }
      },
      "end": "^(?!\\1\\s)",
      "patterns": [
        { "include": "#comment" },
        { "include": "#options-list-item" }
      ]
    },

    "opts-block-scalar": {
      "begin": "^(\\s*)(options|opts)(:)\\s+(\\||>)[-+]?\\s*$",
      "beginCaptures": {
        "2": { "name": "keyword.other.section.xsh" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" },
        "4": { "name": "keyword.control.flow.block-scalar.literal.yaml" }
      },
      "end": "^(?!\\1\\s|\\s*$)",
      "contentName": "meta.synopsis.options.xsh",
      "patterns": [
        { "include": "#comment" },
        { "include": "#synopsis-dsl-options" }
      ]
    },

    "options-list-item": {
      "patterns": [
        { "include": "#options-list-item-double" },
        { "include": "#options-list-item-single" }
      ]
    },

    "options-list-item-double": {
      "begin": "^(\\s+)-\\s+\"",
      "end": "\"\\s*$",
      "contentName": "meta.synopsis.options.xsh",
      "patterns": [
        { "include": "#synopsis-dsl-options" }
      ]
    },

    "options-list-item-single": {
      "begin": "^(\\s+)-\\s+'",
      "end": "'\\s*$",
      "contentName": "meta.synopsis.options.xsh",
      "patterns": [
        { "include": "#synopsis-dsl-options" }
      ]
    },

    "args-section": {
      "begin": "^(\\s*)(arguments|args)(:)\\s*$",
      "beginCaptures": {
        "2": { "name": "keyword.other.section.xsh" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" }
      },
      "end": "^(?!\\1\\s)",
      "patterns": [
        { "include": "#comment" },
        { "include": "#arguments-list-item" }
      ]
    },

    "args-block-scalar": {
      "begin": "^(\\s*)(arguments|args)(:)\\s+(\\||>)[-+]?\\s*$",
      "beginCaptures": {
        "2": { "name": "keyword.other.section.xsh" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" },
        "4": { "name": "keyword.control.flow.block-scalar.literal.yaml" }
      },
      "end": "^(?!\\1\\s|\\s*$)",
      "contentName": "meta.synopsis.arguments.xsh",
      "patterns": [
        { "include": "#comment" },
        { "include": "#synopsis-dsl-arguments" }
      ]
    },

    "arguments-list-item": {
      "patterns": [
        { "include": "#arguments-list-item-double" },
        { "include": "#arguments-list-item-single" }
      ]
    },

    "arguments-list-item-double": {
      "begin": "^(\\s+)-\\s+\"",
      "end": "\"\\s*$",
      "contentName": "meta.synopsis.arguments.xsh",
      "patterns": [
        { "include": "#synopsis-dsl-arguments" }
      ]
    },

    "arguments-list-item-single": {
      "begin": "^(\\s+)-\\s+'",
      "end": "'\\s*$",
      "contentName": "meta.synopsis.arguments.xsh",
      "patterns": [
        { "include": "#synopsis-dsl-arguments" }
      ]
    },

    "args-inline": {
      "patterns": [
        { "include": "#args-inline-double" },
        { "include": "#args-inline-single" },
        { "include": "#args-inline-bare" }
      ]
    },

    "args-inline-double": {
      "begin": "^(\\s*)(arguments|args)(:)(\\s+)\"",
      "beginCaptures": {
        "2": { "name": "keyword.other.section.xsh" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" }
      },
      "end": "\"\\s*$",
      "contentName": "meta.synopsis.arguments.xsh",
      "patterns": [
        { "include": "#synopsis-dsl-arguments" }
      ]
    },

    "args-inline-single": {
      "begin": "^(\\s*)(arguments|args)(:)(\\s+)'",
      "beginCaptures": {
        "2": { "name": "keyword.other.section.xsh" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" }
      },
      "end": "'\\s*$",
      "contentName": "meta.synopsis.arguments.xsh",
      "patterns": [
        { "include": "#synopsis-dsl-arguments" }
      ]
    },

    "args-inline-bare": {
      "match": "^(\\s*)(arguments|args)(:)(\\s+)([^\\s#'\"]+)\\s*$",
      "captures": {
        "2": { "name": "keyword.other.section.xsh" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" },
        "5": {
          "patterns": [
            { "include": "#synopsis-dsl-arguments" }
          ]
        }
      }
    },

    "synopsis-dsl-options": {
      "patterns": [
        { "include": "#synopsis-flags" },
        { "include": "#synopsis-param" },
        { "include": "#synopsis-choice-options" },
        { "include": "#synopsis-enum" },
        { "include": "#synopsis-brackets" },
        { "include": "#synopsis-punctuation" }
      ]
    },

    "synopsis-dsl-arguments": {
      "patterns": [
        { "include": "#synopsis-param" },
        { "include": "#synopsis-choice-arguments" },
        { "include": "#synopsis-enum" },
        { "include": "#synopsis-brackets" },
        { "include": "#synopsis-punctuation" }
      ]
    },

    "synopsis-flags": {
      "match": "(--[a-zA-Z][a-zA-Z0-9-]*|-[a-zA-Z]\\b)",
      "name": "variable.parameter.argument-name.xsh"
    },

    "synopsis-choice-options": {
      "match": "(\\()([^)]*)(\\))",
      "captures": {
        "1": { "name": "punctuation.definition.group.synopsis.xsh" },
        "2": {
          "patterns": [
            { "include": "#synopsis-flags" },
            { "include": "#synopsis-punctuation" }
          ]
        },
        "3": { "name": "punctuation.definition.group.synopsis.xsh" }
      }
    },

    "synopsis-choice-arguments": {
      "match": "(\\()([^)]*)(\\))",
      "captures": {
        "1": { "name": "punctuation.definition.group.synopsis.xsh" },
        "2": {
          "patterns": [
            { "match": "[a-zA-Z][a-zA-Z0-9_-]*", "name": "variable.parameter" },
            { "include": "#synopsis-punctuation" }
          ]
        },
        "3": { "name": "punctuation.definition.group.synopsis.xsh" }
      }
    },

    "synopsis-param": {
      "match": "(<)([^>]*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.group.synopsis.xsh" },
        "2": {
          "name": "variable.parameter",
          "patterns": [
            { "include": "#synopsis-punctuation" }
          ]
        },
        "3": { "name": "punctuation.definition.group.synopsis.xsh" }
      }
    },

    "synopsis-enum": {
      "match": "(\\{)([^}]*)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.group.synopsis.xsh" },
        "2": {
          "patterns": [
            { "match": "[a-zA-Z][a-zA-Z0-9_-]*", "name": "variable.parameter" },
            { "include": "#synopsis-punctuation" }
          ]
        },
        "3": { "name": "punctuation.definition.group.synopsis.xsh" }
      }
    },

    "synopsis-brackets": {
      "match": "[\\[\\]]",
      "name": "punctuation.definition.group.synopsis.xsh"
    },

    "synopsis-punctuation": {
      "patterns": [
        {
          "match": "\\|",
          "name": "punctuation.definition.group.synopsis.xsh"
        },
        {
          "match": "=",
          "name": "punctuation.definition.group.synopsis.xsh"
        },
        {
          "match": "'",
          "name": "punctuation.definition.group.synopsis.xsh"
        },
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.variadic.synopsis.xsh"
        }
      ]
    },

    "command-key": {
      "match": "^(\\s*)(\"[^\"]*\"|'[^']*'|[a-zA-Z][a-zA-Z0-9._-]*)(:)",
      "captures": {
        "2": { "name": "entity.name.function" },
        "3": { "name": "punctuation.separator.key-value.mapping.yaml" }
      }
    },

    "x-builtin-directive": {
      "match": "\\bx-(?:opts-set|args-set|opt|arg|opts|args|usage|run|help|prt|tui|io-(?:read|confirm|select))\\b",
      "name": "support.function.x-builtin.xsh"
    },

    "yaml-fallback": {
      "patterns": [
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.yaml"
        },
        {
          "match": "^([a-zA-Z_][a-zA-Z0-9_-]*)(:)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.yaml" },
            "2": { "name": "punctuation.separator.key-value.mapping.yaml" }
          }
        },
        {
          "match": "\"[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*\"",
          "name": "string.quoted.double.yaml"
        },
        {
          "match": "'[^']*'",
          "name": "string.quoted.single.yaml"
        },
        {
          "match": ":\\s+[^\\s#]+",
          "captures": {
            "0": {
              "patterns": [
                {
                  "match": "(?<=:\\s+).+",
                  "name": "string.unquoted.yaml"
                }
              ]
            }
          }
        }
      ]
    },

    "x-template-vars": {
      "patterns": [
        {
          "match": "\\$\\(\\s*x-opt\\s+[^)]+\\)",
          "name": "meta.template.x-opt.xsh",
          "captures": {
            "0": {
              "patterns": [
                {
                  "match": "x-opt",
                  "name": "support.function.x-builtin.xsh"
                },
                {
                  "match": "[a-zA-Z][a-zA-Z0-9_-]+",
                  "name": "variable.parameter.option-name.xsh"
                }
              ]
            }
          }
        },
        {
          "match": "\\$\\(\\s*x-arg\\s+[^)]+\\)",
          "name": "meta.template.x-arg.xsh",
          "captures": {
            "0": {
              "patterns": [
                {
                  "match": "x-arg",
                  "name": "support.function.x-builtin.xsh"
                },
                {
                  "match": "[a-zA-Z][a-zA-Z0-9_-]+",
                  "name": "variable.parameter.argument-name.xsh"
                }
              ]
            }
          }
        },
        {
          "match": "\\$\\(\\s*x-opts\\s*\\)",
          "name": "support.function.x-builtin.xsh"
        },
        {
          "match": "\\$\\(\\s*x-args\\s*\\)",
          "name": "support.function.x-builtin.xsh"
        },
        {
          "match": "\\$\\(\\s*x-run\\s+[^)]+\\)",
          "name": "support.function.x-builtin.xsh"
        }
      ]
    }
  }
}
