{
  "name": "x.sh",
  "scopeName": "source.xsh",
  "fileTypes": [
    "x.yml",
    "cli.yaml",
    "cli.yml"
  ],
  "patterns": [
    { "include": "#comment" },
    { "include": "#import-block" },
    { "include": "#handlers-block" },
    { "include": "#top-level-metadata" },
    { "include": "#options-block" },
    { "include": "#arguments-block" },
    { "include": "#commands-block" },
    { "include": "#yaml-generic" }
  ],
  "repository": {

    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.xsh"
    },

    "top-level-metadata": {
      "patterns": [
        {
          "match": "^(name|version|description)(:)(.*)",
          "captures": {
            "1": { "name": "keyword.other.metadata.xsh" },
            "2": { "name": "punctuation.separator.key-value.xsh" },
            "3": { "name": "string.unquoted.metadata-value.xsh" }
          }
        }
      ]
    },

    "options-block": {
      "begin": "^(\\s*)(options)(:)\\s*$",
      "beginCaptures": {
        "2": { "name": "keyword.other.section.options.xsh" },
        "3": { "name": "punctuation.separator.key-value.xsh" }
      },
      "end": "^(?!\\1)(?=\\S)",
      "patterns": [
        { "include": "#comment" },
        { "include": "#option-list-item" }
      ]
    },

    "option-list-item": {
      "patterns": [
        { "include": "#option-string-block" },
        { "include": "#option-string-inline" },
        { "include": "#option-bare-flag" }
      ]
    },

    "option-string-block": {
      "begin": "^(\\s*)-\\s+(>|\\|)\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.list.xsh" }
      },
      "end": "^(?!\\1\\s)",
      "contentName": "meta.option-expression.xsh",
      "patterns": [
        { "include": "#option-expression-content" }
      ]
    },

    "option-string-inline": {
      "match": "^(\\s*)(-\\s+)(\"?)([^\"\\n]+)(\"?)",
      "captures": {
        "2": { "name": "punctuation.definition.list.xsh" },
        "3": { "name": "punctuation.definition.string.xsh" },
        "4": {
          "patterns": [
            { "include": "#option-expression-content" }
          ]
        },
        "5": { "name": "punctuation.definition.string.xsh" }
      }
    },

    "option-bare-flag": {
      "match": "^(\\s*)(-\\s+)(--[a-zA-Z][a-zA-Z0-9_-]*)\\s*$",
      "captures": {
        "2": { "name": "punctuation.definition.list.xsh" },
        "3": { "name": "variable.other.option.flag.xsh" }
      }
    },

    "option-expression-content": {
      "patterns": [
        {
          "match": "(\\[|\\])",
          "name": "punctuation.bracket.optional.xsh"
        },
        {
          "match": "\\|",
          "name": "keyword.operator.choice.xsh"
        },
        {
          "match": "-{1,2}[a-zA-Z][a-zA-Z0-9_-]*",
          "name": "variable.other.option.flag.xsh"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.xsh"
        },
        {
          "match": "\\{[^}]*\\}",
          "name": "meta.option.enum.xsh",
          "captures": {
            "0": {
              "patterns": [
                {
                  "match": "[^{}|]+",
                  "name": "constant.other.enum-value.xsh"
                },
                {
                  "match": "\\|",
                  "name": "keyword.operator.choice.xsh"
                }
              ]
            }
          }
        },
        {
          "match": "<[^>]*>",
          "name": "meta.option.placeholder.xsh",
          "captures": {
            "0": {
              "patterns": [
                {
                  "match": "[a-zA-Z][a-zA-Z0-9_-]*",
                  "name": "variable.parameter.placeholder.xsh"
                },
                {
                  "match": "=",
                  "name": "keyword.operator.default.xsh"
                },
                {
                  "match": "['\"][^'\"]*['\"]",
                  "name": "string.quoted.default-value.xsh"
                }
              ]
            }
          }
        },
        {
          "match": "\\.{3}",
          "name": "keyword.operator.variadic.xsh"
        }
      ]
    },

    "arguments-block": {
      "patterns": [
        {
          "begin": "^(\\s*)(arguments)(:)\\s*$",
          "beginCaptures": {
            "2": { "name": "keyword.other.section.arguments.xsh" },
            "3": { "name": "punctuation.separator.key-value.xsh" }
          },
          "end": "^(?!\\1)(?=\\S)",
          "patterns": [
            { "include": "#comment" },
            { "include": "#argument-list-item" }
          ]
        },
        {
          "match": "^(\\s*)(arguments)(:)\\s+(.+)$",
          "captures": {
            "2": { "name": "keyword.other.section.arguments.xsh" },
            "3": { "name": "punctuation.separator.key-value.xsh" },
            "4": {
              "patterns": [
                { "include": "#argument-expression-content" }
              ]
            }
          }
        }
      ]
    },

    "argument-list-item": {
      "match": "^(\\s*)(-\\s+)(\"?)([^\"\\n]+)(\"?)",
      "captures": {
        "2": { "name": "punctuation.definition.list.xsh" },
        "3": { "name": "punctuation.definition.string.xsh" },
        "4": {
          "patterns": [
            { "include": "#argument-expression-content" }
          ]
        },
        "5": { "name": "punctuation.definition.string.xsh" }
      }
    },

    "argument-expression-content": {
      "patterns": [
        {
          "match": "(\\[|\\])",
          "name": "punctuation.bracket.optional.xsh"
        },
        {
          "match": "\\|",
          "name": "keyword.operator.choice.xsh"
        },
        {
          "match": "\\.{3}",
          "name": "keyword.operator.variadic.xsh"
        },
        {
          "match": "\\([^)]*\\)",
          "name": "meta.argument.choice.xsh",
          "captures": {
            "0": {
              "patterns": [
                {
                  "match": "[^()|]+",
                  "name": "constant.other.choice-value.xsh"
                },
                {
                  "match": "\\|",
                  "name": "keyword.operator.choice.xsh"
                }
              ]
            }
          }
        },
        {
          "match": "<[^>]*>",
          "name": "meta.argument.placeholder.xsh",
          "captures": {
            "0": {
              "patterns": [
                {
                  "match": "[a-zA-Z][a-zA-Z0-9_-]*(?==)",
                  "name": "variable.parameter.argument.xsh"
                },
                {
                  "match": "=",
                  "name": "keyword.operator.default.xsh"
                },
                {
                  "match": "[a-zA-Z][a-zA-Z0-9_-]*",
                  "name": "variable.parameter.argument.xsh"
                },
                {
                  "match": "['\"][^'\"]*['\"]",
                  "name": "string.quoted.default-value.xsh"
                }
              ]
            }
          }
        }
      ]
    },

    "commands-block": {
      "begin": "^(commands)(:)\\s*$",
      "beginCaptures": {
        "1": { "name": "keyword.other.section.commands.xsh" },
        "2": { "name": "punctuation.separator.key-value.xsh" }
      },
      "end": "^(?=\\S)",
      "patterns": [
        { "include": "#comment" },
        { "include": "#command-entry" }
      ]
    },

    "command-entry": {
      "begin": "^(\\s+)([a-zA-Z][a-zA-Z0-9_-]*)(:)\\s*$",
      "beginCaptures": {
        "2": { "name": "entity.name.function.command.xsh" },
        "3": { "name": "punctuation.separator.key-value.xsh" }
      },
      "end": "^(?!\\1\\s)",
      "patterns": [
        { "include": "#comment" },
        {
          "match": "^(\\s+)(description)(:)(.*)",
          "captures": {
            "2": { "name": "keyword.other.command.description.xsh" },
            "3": { "name": "punctuation.separator.key-value.xsh" },
            "4": { "name": "string.unquoted.description.xsh" }
          }
        },
        { "include": "#options-block" },
        { "include": "#arguments-block" },
        { "include": "#nested-commands-block" }
      ]
    },

    "nested-commands-block": {
      "begin": "^(\\s+)(commands)(:)\\s*$",
      "beginCaptures": {
        "2": { "name": "keyword.other.section.commands.xsh" },
        "3": { "name": "punctuation.separator.key-value.xsh" }
      },
      "end": "^(?!\\1\\s)",
      "patterns": [
        { "include": "#comment" },
        { "include": "#nested-command-entry" }
      ]
    },

    "nested-command-entry": {
      "begin": "^(\\s+)([a-zA-Z][a-zA-Z0-9_-]*)(:)\\s*$",
      "beginCaptures": {
        "2": { "name": "entity.name.function.command.xsh" },
        "3": { "name": "punctuation.separator.key-value.xsh" }
      },
      "end": "^(?!\\1\\s)",
      "patterns": [
        { "include": "#comment" },
        {
          "match": "^(\\s+)(description)(:)(.*)",
          "captures": {
            "2": { "name": "keyword.other.command.description.xsh" },
            "3": { "name": "punctuation.separator.key-value.xsh" },
            "4": { "name": "string.unquoted.description.xsh" }
          }
        },
        { "include": "#options-block" },
        { "include": "#arguments-block" }
      ]
    },

    "import-block": {
      "match": "^(\"\\$\\.import\"|\\$\\.import)(:)(.*)",
      "captures": {
        "1": { "name": "keyword.other.section.handlers.xsh" },
        "2": { "name": "punctuation.separator.key-value.xsh" },
        "3": { "name": "string.unquoted.import-path.xsh" }
      }
    },

    "handlers-block": {
      "begin": "^(\"\\$\"|\\$)(:)\\s*$",
      "beginCaptures": {
        "1": { "name": "keyword.other.section.handlers.xsh" },
        "2": { "name": "punctuation.separator.key-value.xsh" }
      },
      "end": "^(?=\\S)",
      "patterns": [
        { "include": "#comment" },
        { "include": "#handler-block-literal" },
        { "include": "#handler-inline-quoted" },
        { "include": "#handler-inline" }
      ]
    },

    "handler-inline-quoted": {
      "match": "^(\\s+)(\"[^\"]*\"|'[^']*'|[a-zA-Z][a-zA-Z0-9._-]*)(:)\\s+(\"[^\"]*\"|'[^']*')\\s*$",
      "captures": {
        "2": { "name": "variable.other.handler-key.xsh" },
        "3": { "name": "punctuation.separator.key-value.xsh" },
        "4": {
          "contentName": "meta.embedded.line.shell",
          "patterns": [
            { "include": "#x-template-vars" },
            { "include": "source.shell" }
          ]
        }
      }
    },

    "handler-inline": {
      "match": "^(\\s+)(\"[^\"]*\"|'[^']*'|[a-zA-Z][a-zA-Z0-9._-]*)(:)\\s+(.*)$",
      "captures": {
        "2": { "name": "variable.other.handler-key.xsh" },
        "3": { "name": "punctuation.separator.key-value.xsh" },
        "4": {
          "contentName": "meta.embedded.line.shell",
          "patterns": [
            { "include": "#x-builtin-directive" },
            { "include": "#x-template-vars" },
            { "include": "source.shell" }
          ]
        }
      }
    },

    "handler-block-literal": {
      "begin": "^(\\s+)(\"[^\"]*\"|'[^']*'|[a-zA-Z][a-zA-Z0-9._-]*)(:)\\s+(\\||>)\\s*$",
      "beginCaptures": {
        "2": { "name": "variable.other.handler-key.xsh" },
        "3": { "name": "punctuation.separator.key-value.xsh" },
        "4": { "name": "keyword.control.block-scalar.xsh" }
      },
      "end": "^(?!\\1\\s|\\s*$)",
      "contentName": "meta.embedded.block.shell",
      "patterns": [
        { "include": "#x-template-vars" },
        { "include": "source.shell" }
      ]
    },

    "x-builtin-directive": {
      "match": "\\bx-(?:opt|arg|opts|args|usage|run|help|prt|tui|io-(?:read|confirm|select))\\b",
      "name": "support.function.x-builtin.xsh"
    },

    "x-template-vars": {
      "patterns": [
        {
          "match": "\\$\\(\\s*x-opt\\s+[^)]+\\)",
          "name": "meta.template.x-opt.xsh",
          "captures": {
            "0": {
              "patterns": [
                {
                  "match": "x-opt",
                  "name": "support.function.x-builtin.xsh"
                },
                {
                  "match": "[a-zA-Z][a-zA-Z0-9_-]+",
                  "name": "variable.parameter.option-name.xsh"
                }
              ]
            }
          }
        },
        {
          "match": "\\$\\(\\s*x-arg\\s+[^)]+\\)",
          "name": "meta.template.x-arg.xsh",
          "captures": {
            "0": {
              "patterns": [
                {
                  "match": "x-arg",
                  "name": "support.function.x-builtin.xsh"
                },
                {
                  "match": "[a-zA-Z][a-zA-Z0-9_-]+",
                  "name": "variable.parameter.argument-name.xsh"
                }
              ]
            }
          }
        },
        {
          "match": "\\$\\(\\s*x-opts\\s*\\)",
          "name": "support.function.x-builtin.xsh"
        },
        {
          "match": "\\$\\(\\s*x-args\\s*\\)",
          "name": "support.function.x-builtin.xsh"
        },
        {
          "match": "\\$\\(\\s*x-run\\s+[^)]+\\)",
          "name": "support.function.x-builtin.xsh"
        }
      ]
    },

    "yaml-generic": {
      "patterns": [
        {
          "match": "^([a-zA-Z_][a-zA-Z0-9_-]*)(:)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.yaml" },
            "2": { "name": "punctuation.separator.key-value.xsh" }
          }
        },
        {
          "match": "\"[^\"]*\"",
          "name": "string.quoted.double.yaml"
        },
        {
          "match": "'[^']*'",
          "name": "string.quoted.single.yaml"
        }
      ]
    }
  }
}
