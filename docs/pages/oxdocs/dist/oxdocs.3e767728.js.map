# bash handlers, keyed by dotted command path
$:
  build: |
    echo "mode=$(x-opt mode), assets=$(x-arg assets)"
  create: x-usage create        # default: print help when called bare
  create.file: |
    echo "creating $(x-arg path) with $(x-arg content)"
  create.folder: |
