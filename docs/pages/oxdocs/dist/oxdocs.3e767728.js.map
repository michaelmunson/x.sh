function $5490d9ebbe246f89$export$2e2bcd8739ae039() {
    return [
        (0, $5edaeaae786b8e62$export$358a232cca1ab2ac)("**x** is a Rust-powered CLI that helps you create, organize, and run scripts across projects. Think of it as a script registry with metadata, editor integration, and optional symlinks into your PATH \u2014 plus two YAML-based layers for project commands and full multi-command apps."),
        (0, $aba8666de066649d$export$a8a3e93435678ff9)(3, "What makes x different"),
        (0, $3412493f9079b31e$export$546f606c73d35982)([
            "**Global scripts** live in `~/.x.sh/scripts/` with per-script metadata (description, language, groups) and usage tracking.",
            "**Project-local commands** in `./x.yml` let you version-control task runners alongside your repo \u2014 no install step required for teammates.",
            "**Apps** (`&lt;name&gt;.x.yml`) turn YAML into validated CLIs with options, arguments, nested subcommands, and bash handlers \u2014 before any bash runs, x parses and validates the user's input.",
            "**AI helpers** (`x --ai`, `x -i --ai`) generate shell commands and scripts when you configure an LLM provider."
        ]),
        (0, $aba8666de066649d$export$a8a3e93435678ff9)(3, "Three ways to run a command"),
        (0, $40b858da8422a367$export$6c415d1fdae3dfdb)(`1. ./x.yml          \u{2192} project-local inline script (CWD only)
2. ./&lt;name&gt;.x.yml    \u{2192} local app (CWD, then parent dirs)
3. ~/.x.sh/apps/     \u{2192} global app
4. ~/.x.sh/scripts/  \u{2192} installed global script`, "Resolution order when you run `x &lt;name&gt; \u2026`", "text"),
        (0, $f765f9b3c79f2d01$export$97a5aca3dea8edc7)("tip", "Use `x --src &lt;name&gt;` to print the absolute path of a script or app file without executing it \u2014 handy for piping into editors or CI.")
    ];
}



