        (0, $40b858da8422a367$export$6c415d1fdae3dfdb)(`x -i --app my-app             # prompts for local vs global
x -i --app --local my-app     # ./my-app.x.yml
x -i --app --global my-app    # ~/.x.sh/apps/my-app.x.yml`),
        (0, $5edaeaae786b8e62$export$358a232cca1ab2ac)("After the editor closes, x validates the YAML structure, parses every synopsis string, and checks handler coverage. On failure you can **edit** (re-open) or **revert** (restore prior file or delete the new one)."),
